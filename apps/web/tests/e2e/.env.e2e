# ============================================================
# Ambiente E2E - Variáveis de ambiente
# Copie este arquivo para .env.e2e e preencha os valores
# ============================================================

# ============================================
# PostgreSQL (obrigatório)
# ============================================

# Conexão com o Postgres de dev. Necessária para que os specs
# BOLA/multi-tenant (`tests/security/multitenant.spec.ts`)
# façam asserts diretos no DB (verificação de que mutações
# cross-tenant não vazaram dados).
DATABASE_URL=postgresql://user:password@localhost:5432/pedi_ai

# ============================================
# Opcional
# ============================================

# URL base da aplicação web (Next.js) — default: http://localhost:3000
# BASE_URL=http://localhost:3000

# URL do NestJS para os testes BOLA (`tests/security/multitenant.spec.ts`).
# Os Route Handlers do Next dependem de `NEXT_PUBLIC_API_URL`, que em dev
# local aponta para :3009 (porta de teste dedicada) — não usar. Os specs
# BOLA precisam bater DIRETO no NestJS (:3001) para testar a regra de
# negócio real de tenant isolation. Default: http://localhost:3001.
E2E_API_URL=http://localhost:3001
