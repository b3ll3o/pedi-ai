# ============================================================
# Next.js Web Dockerfile — Development (hot reload)
# Build context: repo root (.)
# ============================================================

FROM node:20-alpine AS base

RUN npm install -g pnpm@9

# Native build tools for sharp and other native modules
# `bash` é necessário pelo deploy workflow (deploy-vps.yml) que executa
# E2E via `docker exec pedi_ai_web bash -c "..."`. Imagem base Alpine só
# traz `sh` (busybox), insuficiente para `bash -c` com quoting mais rico.
RUN apk add --no-cache python3 make g++ curl bash

WORKDIR /app

# Copy workspace files for monorepo resolution
# `package.json` (root) DEVE vir antes de `pnpm install` — `pnpm.overrides`
# é necessário para forçar versões únicas (ex.: ioredis) entre workspaces.
COPY package.json ./
COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./

# Copy packages (for monorepo deps resolution)
COPY packages ./packages

# Copy Next.js app source
COPY apps/web/src ./src
COPY apps/web/public ./public
COPY apps/web/next.config.ts ./
COPY apps/web/tsconfig.json ./
COPY apps/web/package.json ./

# Install dependencies
RUN pnpm install --no-frozen-lockfile --ignore-scripts

EXPOSE 3000

# Development command with hot reload
CMD ["sh", "-c", "pnpm dev"]