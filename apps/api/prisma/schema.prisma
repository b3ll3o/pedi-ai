// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────

enum OrderStatus {
  pending_payment
  paid
  preparing
  ready
  delivered
  cancelled
}

enum PaymentMethod {
  cash
  credit_card
  debit_card
  pix
  other
}

enum PaymentStatus {
  pending
  paid
  refunded
  failed
}

enum UserRole {
  dono
  gerente
  atendente
  cliente
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired
}

// Feature Flags — RF-ADM-FF-01..10 (apps/api/.openspec/changes/feature-flags-runtime/design.md §4)
enum FlagScope {
  GLOBAL
  RESTAURANT
  USER
}

enum FlagValueType {
  BOOLEAN
  STRING
  NUMBER
  JSON
}

// ── Tables ─────────────────────────────────────────────────────

model Restaurant {
  id          String   @id @default(uuid())
  name        String
  slug        String?
  description String?
  address     String?
  phone       String?
  logoUrl     String?
  active      Boolean  @default(true)
  settings    String? // JSON as string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tables         Table[]
  categories     Category[]
  products       Product[]
  usersProfiles  UsersProfile[]
  orders         Order[]
  paymentIntents PaymentIntent[]
  subscriptions  Subscription[]
  modifierGroups ModifierGroup[]
  combos         Combo[]

  // Referral: 1:1 (restaurant → seu próprio Referral como referrer)
  // + 1:N (restaurant → conversões onde foi o referred)
  referralAsOwner    Referral?           @relation("ReferralOwner")
  referralAsReferred ReferralConversion? @relation("ReferredByReferral")

  // Auditoria ACHADO-N4 (Re-varredura 8): `slug` era String? sem
  // @unique/@@index. Rota pública /restaurants/slug/:slug fazia
  // findFirst em todos os restaurants a cada GET de cardápio.
  // Com 1000+ tenants, latência degradava linearmente (sequential scan).
  // @@index (não @unique) preserva slugs duplicados entre tenants
  // diferentes — escopo da unicidade é opcional.
  @@index([slug])
}

model Table {
  id           String    @id @default(uuid())
  restaurantId String
  number       Int
  qrCode       String?
  name         String?
  capacity     Int?
  active       Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Restrict: impede deletar Restaurant se houver Tables. Garante que
  // dados de mesas (histórico de pedidos, QR codes) não sejam perdidos
  // acidentalmente. Para "deletar" um restaurante, use soft-delete ou
  // cascade explícito após migrar Orders/PaymentIntents.
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  orders     Order[]

  @@index([restaurantId])
}

model Category {
  id           String    @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  imageUrl     String?
  sortOrder    Int       @default(0)
  active       Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  products   Product[]

  @@index([restaurantId])
}

model Product {
  id            String   @id @default(uuid())
  // Auditoria P0-01 (2026-07-29): `restaurantId` adicionado para
  // garantir isolamento multi-tenant. Antes, o tenant era inferido via
  // `categoryId → Category.restaurantId`, deixando `findById`/`findMany`
  // vulneráveis a BOLA (OWASP API #1). Ver migration
  // `20260729120000_add_product_restaurant_id` para backfill idempotente.
  restaurantId  String
  categoryId    String
  name          String
  description   String?
  imageUrl      String?
  price         Float
  dietaryLabels String?
  available     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant            Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category              Category               @relation(fields: [categoryId], references: [id])
  orderItems            OrderItem[]
  comboItems            ComboItem[]
  productModifierGroups ProductModifierGroup[]

  @@index([categoryId])
  @@index([restaurantId])
}

model ModifierGroup {
  id            String   @id @default(uuid())
  restaurantId  String
  name          String
  required      Boolean  @default(false)
  minSelections Int      @default(0)
  maxSelections Int      @default(1)
  createdAt     DateTime @default(now())

  restaurant            Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  modifierValues        ModifierValue[]
  productModifierGroups ProductModifierGroup[]

  @@index([restaurantId])
}

model ModifierValue {
  id              String   @id @default(uuid())
  modifierGroupId String
  name            String
  priceAdjustment Float    @default(0)
  available       Boolean  @default(true)
  createdAt       DateTime @default(now())

  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)

  @@index([modifierGroupId])
}

model Combo {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  bundlePrice  Float
  imageUrl     String?
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  comboItems ComboItem[]
  orderItems OrderItem[]

  @@index([restaurantId])
}

model ComboItem {
  id        String   @id @default(uuid())
  comboId   String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([comboId])
  @@index([productId])
}

// Auditoria A-AD-05: dedupe atômico via tabela dedicada com unique composto.
// O fluxo é:
//   1. INSERT IdempotencyKey { scope, key } — se P2002, dedupe disparou.
//   2. INSERT Order (operação original).
//   3. Se Order falhar, DELETE IdempotencyKey para permitir retry.
// Sem unique composto, `findFirst` antes do `create` sofre race condition
// (TOCTOU). Esta tabela resolve a nível de DB.
model IdempotencyKey {
  id         String   @id @default(uuid())
  scope      String // ex: "order:create", "payment:create"
  key        String // valor do header Idempotency-Key do cliente
  resultHash String? // hash do response para retornar mesma resposta
  createdAt  DateTime @default(now())
  expiresAt  DateTime // TTL: 24h (cleanup via job/cron)

  @@unique([scope, key])
  @@index([expiresAt])
}

model Order {
  id             String         @id @default(uuid())
  restaurantId   String
  tableId        String?
  customerId     String?
  customerPhone  String?
  customerName   String?
  customerEmail  String?
  status         OrderStatus    @default(pending_payment)
  // Auditoria ACHADO-6 (Re-varredura 5): optimistic locking para evitar
  // TOCTOU entre webhook do Mercado Pago e mudanças de status por staff.
  // Sem version, um webhook "paid" que chega ao mesmo tempo que um staff
  // que clica em "cancelled" pode fazer last-write-wins silencioso.
  // O `update`/`updateMany` deve incluir `where: { id, version }` e
  // incrementar `version` na mesma operação. Conflito → 409.
  version        Int            @default(0)
  subtotal       Float
  tax            Float
  total          Float
  paymentMethod  PaymentMethod?
  paymentStatus  PaymentStatus  @default(pending)
  idempotencyKey String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  table          Table?               @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  paymentIntents PaymentIntent[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([customerId])
  // Auditoria ACHADO-N14 (Re-varredura 8): lookup por `idempotencyKey`
  // acontecia sem índice. Em produção com >100k pedidos, latência do
  // findFirst degradava linearmente (sequential scan). Agora:
  // @@index([restaurantId, idempotencyKey]) — composto porque a chave
  // é única por restaurante (escopo multi-tenant).
  @@index([restaurantId, idempotencyKey])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String?
  comboId    String?
  quantity   Int
  unitPrice  Float
  totalPrice Float
  notes      String?
  createdAt  DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // SetNull (não Restrict) ao deletar Product/Combo: preserva histórico de
  // pedidos já pagos. O item aparece com productId=null mas mantém o
  // unitPrice/totalPrice para fins fiscais/auditoria.
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  combo   Combo?   @relation(fields: [comboId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  notes     String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model UsersProfile {
  id           String   @id @default(uuid())
  userId       String?  @unique
  restaurantId String?
  role         UserRole @default(cliente)
  name         String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())

  // SetNull: se Restaurant for deletado (cenário raro), preserva o
  // perfil do usuário mas desvincula do restaurante. Cascade apagaria
  // também refresh tokens, password resets, etc — perda irreversível.
  restaurant          Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]

  @@index([restaurantId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user UsersProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Refresh tokens com rotação e revogação.
/// Cada refresh emite um novo registro e revoga o anterior (cadeia auditável).
/// Reuso de token revogado → invalida toda a família (detecção de reuso).
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String    @unique
  /// Família de rotação — todos os tokens descendentes compartilham este ID.
  familyId      String
  /// Token que substituiu este na rotação (preenchido após rotação).
  replacedById  String?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?

  user UsersProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PaymentIntent {
  id                   String        @id @default(uuid())
  orderId              String
  restaurantId         String
  amount               Float
  currency             String        @default("BRL")
  status               PaymentStatus @default(pending)
  paymentMethod        String
  mercadoPagoPaymentId String?
  qrCode               String?
  qrCodeBase64         String?
  expiresAt            DateTime?
  createdAt            DateTime      @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([restaurantId])
}

model Subscription {
  id                    String             @id @default(uuid())
  restaurantId          String
  status                SubscriptionStatus
  planType              String
  priceCents            Int
  currency              String             @default("BRL")
  trialStartedAt        DateTime
  trialEndsAt           DateTime
  trialDays             Int
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?
  cancelledAt           DateTime?
  /// ID da subscription no Asaas (pra mapear webhook → Subscription nossa).
  /// NULL = subscription manual (sem integração Asaas).
  asaasSubscriptionId   String?            @unique
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  version               Int                @default(1)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  // HIGH-011 (2ª varredura QA): @@unique garante que cada restaurante tem
  // no máximo 1 Subscription, habilitando `upsert` seguro por `restaurantId`
  // e evitando multi-tenant data leak (N assinaturas por restaurante).
  @@unique([restaurantId])
  @@index([restaurantId])
}

model ProductModifierGroup {
  id              String   @id @default(uuid())
  productId       String
  modifierGroupId String
  createdAt       DateTime @default(now())

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierGroupId])
  @@index([productId])
  @@index([modifierGroupId])
}

/// WebhookEvent — idempotência de webhooks de pagamento (P0-04)
///
/// Antes do fix: o model só tinha `id` (PK) usado como eventId do provider
/// e `eventType` — sem `provider`/`externalId` separados. Webhooks de
/// providers diferentes (MP ↔ Asaas) com mesmo `externalId` poderiam
/// coexistir e o INSERT do segundo era processado normalmente, gerando
/// débito PIX duplicado em produção.
///
/// Depois do fix: `provider` + `externalId` formam a chave lógica do
/// evento. A unique constraint em `externalId` (GLOBAL) impede colisão
/// cross-provider — qualquer INSERT com `externalId` já presente falha
/// com P2002, e o serviço reconhece como `duplicate`.
///
/// NOTA: a constraint é GLOBAL (`@@unique([externalId])`), não composta
/// (`@@unique([provider, externalId])`). A composta permitiria o cenário
/// bug — `(mercadopago, X)` e `(asaas, X)` são tuples distintas e
/// passariam. O bug exige isolamento GLOBAL do externalId.
///
/// `id` (PK) permanece como `eventId` do provider para manter a API
/// existente do `payments.service.ts` (`tx.webhookEvent.create({ data: { id, ... } })`)
/// e a semântica "INSERT é o claim atômico da transação".
model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  externalId  String   @unique
  eventType   String
  payload     Json?
  receivedAt  DateTime @default(now())
  processedAt DateTime @default(now())

  @@index([provider, receivedAt])
}

/// FeatureFlag (aggregate root) — RF-ADM-FF-01..04
model FeatureFlag {
  id           String        @id @default(cuid())
  key          String        @unique
  description  String?
  valueType    FlagValueType @default(BOOLEAN)
  defaultValue Json
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  updatedBy    String?

  overrides FeatureFlagOverride[]
  audits    FeatureFlagAuditLog[]

  @@map("feature_flags")
}

/// Override de flag por escopo (RF-ADM-FF-05..07)
model FeatureFlagOverride {
  id         String    @id @default(cuid())
  flagId     String
  scope      FlagScope
  scopeId    String?
  /// Porcentagem 0..100 para rollout determinístico (RF-ADM-FF-08)
  rolloutPct Int?
  value      Json
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String?

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, scope, scopeId])
  @@index([flagId, scope, scopeId])
  @@index([expiresAt])
  @@map("feature_flag_overrides")
}

/// Audit log imutável (RNF-RELI-FF-01) — gravado na mesma transação da mutação
model FeatureFlagAuditLog {
  id        String   @id @default(cuid())
  flagId    String
  actorId   String
  /// CREATE | UPDATE | TOGGLE | OVERRIDE_ADD | OVERRIDE_REMOVE | ROLLOUT_CHANGE
  action    String
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime @default(now())

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId, createdAt])
  @@index([actorId, createdAt])
  @@map("feature_flag_audit_logs")
}

// ── Referral System ──────────────────────────────────────────────

enum ReferralStatus {
  pending /// Aceitando referrals
  cancelled /// Desabilitado pelo dono ou admin
  expired /// Desabilitado por atingir limite (100 conversões)
}

enum ReferralConversionStatus {
  pending /// Signup feito, ainda não assinou
  rewarded /// Primeira assinatura confirmada, reward aplicado
  cancelled /// Cancelado (fraude, reembolso, etc)
}

/// Programa de referral — 1:1 com Restaurant (cada restaurante tem 1 Referral)
/// @see apps/web/src/domain/referral/Referral.ts
model Referral {
  id                        String         @id @default(uuid())
  /// Restaurante que indica (referrer). UNIQUE garante 1:1.
  referrerRestaurantId      String         @unique
  /// Código único de 8 caracteres (sem I, O, 0, 1).
  code                      String         @unique
  /// Total de pessoas que se cadastraram usando este código.
  totalSignups              Int            @default(0)
  /// Total de conversões (referred assinou pela primeira vez).
  totalConversions          Int            @default(0)
  /// Tier de reward acumulado em meses extras (1/2/3 baseado em tier).
  rewardCreditMonths        Int            @default(0)
  /// Reward já aplicado em faturas anteriores.
  rewardCreditAppliedMonths Int            @default(0)
  status                    ReferralStatus @default(pending)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  /// Optimistic locking (auditoria M-03).
  version                   Int            @default(1)

  referrerRestaurant Restaurant           @relation("ReferralOwner", fields: [referrerRestaurantId], references: [id], onDelete: Restrict)
  conversions        ReferralConversion[]

  @@index([code])
  @@index([status])
  @@map("referrals")
}

/// Conversão de referral — 1:1 com Restaurant (1 referred → 1 conversion max)
/// Rastreia o ciclo: signup → primeira assinatura → reward creditado
model ReferralConversion {
  id                       String                   @id @default(uuid())
  referralId               String
  /// Restaurante que foi indicado (referred). UNIQUE garante 1:1.
  referredRestaurantId     String                   @unique
  status                   ReferralConversionStatus @default(pending)
  /// Quando o referred assinou (1ª cobrança confirmada).
  convertedAt              DateTime?
  /// Quando o reward foi aplicado no referrer.
  rewardedAt               DateTime?
  /// Meses de reward creditados (1 mês padrão).
  rewardMonths             Int                      @default(1)
  /// ID da assinatura que ativou a conversão (FK lógica).
  triggeringSubscriptionId String?
  createdAt                DateTime                 @default(now())

  referral           Referral   @relation(fields: [referralId], references: [id], onDelete: Restrict)
  referredRestaurant Restaurant @relation("ReferredByReferral", fields: [referredRestaurantId], references: [id], onDelete: Restrict)

  @@index([referralId])
  @@index([status])
  @@map("referral_conversions")
}
