# ====================================
# NestJS API Dockerfile — Development (hot reload)
# Build context: repo root (.)
# ====================================

FROM node:20-alpine AS base

RUN npm install -g pnpm@9 && apk add --no-cache postgresql-client curl procps openssl

WORKDIR /app

# Copy workspace files
# `package.json` (root) DEVE vir antes de `pnpm install` — é onde mora
# `pnpm.overrides.ioredis` que força todos os pacotes a usarem a mesma
# versão. Sem isto, bullmq (pinned 5.10.1) e apps/api (^5.4.1 → 5.11.1)
# são instalados em cópias separadas, gerando TS2322 no build.
COPY package.json ./
COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/api ./apps/api

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Build the shared package first — `packages/shared/dist` é .gitignored
# e os imports `@pedi-ai/shared/types`/`@pedi-ai/shared/constants` no
# api precisam do dist gerado pra resolver. Sem isto: pnpm run build
# falha com TS2307 em ~23 lugares (subscriptions.service.ts etc).
RUN pnpm --filter @pedi-ai/shared build

# Generate Prisma client
RUN cd /app/apps/api && pnpm exec prisma generate

# Build the app
RUN cd /app/apps/api && pnpm run build

EXPOSE 3001

# Development command - run built dist
CMD ["sh", "-c", "cd /app/apps/api && node dist/main"]