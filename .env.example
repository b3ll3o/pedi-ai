# ============================================================
# Pedi-AI — Variáveis de Ambiente
# Use para desenvolvimento local ou deploy Docker/VPS
# Copie para `.env` na raiz do projeto
#
# Em produção, TODAS as vars marcadas com [REQUIRED-PROD] devem
# estar preenchidas — caso contrário a API recusa iniciar.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_PASSWORD=sua-senha-forte-aqui

# ── JWT (Gere com: openssl rand -hex 32) ────────────────────
# [REQUIRED-PROD] Segredo do access token (mín. 256 bits).
JWT_SECRET=
# [REQUIRED-PROD] Segredo do refresh token (mín. 256 bits).
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# [REQUIRED-PROD] Issuer (iss) e audience (aud) dos tokens JWT.
# Sem eles, tokens cross-system seriam aceitos. Use valores únicos
# por ambiente (ex: pedi-ai-api / pedi-ai-clients em prod).
JWT_ISSUER=pedi-ai-api
JWT_AUDIENCE=pedi-ai-clients

# ── API ──────────────────────────────────────────────────────
# Porta da API NestJS (não alterar sem ajustar nginx + systemd).
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# CORS: lista separada por vírgulas. NÃO use 0.0.0.0 — apenas origens explícitas.
# Em produção, use https://seudominio.com,https://www.seudominio.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Web (Next.js) ────────────────────────────────────────────
# URL pública da API (vista pelo browser; em prod aponta pro domínio).
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL pública do próprio web (vista pelo browser; em prod aponta pro domínio).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Desliga telemetria do Next (Vercel).
NEXT_TELEMETRY_DISABLED=1

# ── Database ─────────────────────────────────────────────────
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://user:***@localhost:5432/pedi_ai

# ── PII Encryption (LGPD Art. 46) ──────────────────────────
# [REQUIRED-PROD] Chave AES-256-GCM (64 chars hex = 32 bytes).
# Gere com: openssl rand -hex 32
# Sem ela, PII seria persistido em plaintext (LGPD Art. 46).
PII_ENCRYPTION_KEY=

# ── Secrets de Infraestrutura ──────────────────────────────
# [REQUIRED-PROD] Chave para assinar QR Codes de mesa (≥ 32 bytes).
QR_SECRET_KEY=
# [REQUIRED-PROD] Chave para sessões (cookie session).
SESSION_SECRET=
# [REQUIRED-PROD] Chave para assinar cookies HttpOnly.
COOKIE_SECRET=
# [REQUIRED-PROD] Chave anti-CSRF.
CSRF_SECRET=

# ── Redis (BullMQ) ──────────────────────────────────────────
# Opcional em dev (filas operam em modo no-op).
# Em prod, recomenda-se Redis dedicado.
REDIS_URL=redis://127.0.0.1:6379

# ── SMTP (Mailpit dev) ───────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ── Mercado Pago (opcional) ──────────────────────────────────
# [REQUIRED-PROD] Segredo do webhook PIX — sem ele, webhooks são recusados.
MP_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_DEMO_PAYMENT_MODE=false
MP_WEBHOOK_URL=

# ── Asaas (Billing SaaS) ────────────────────────────────────
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox  # sandbox | production
ASAAS_WEBHOOK_SECRET=
ASAAS_WEBHOOK_URL=

# ── Resend (Email transacional) ──────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@pedi.ai
RESEND_FROM_NAME=PediAI

# ── Sentry (Error Tracking) — auditoria P1-1 ──────────────────
# Sem DSN configurado, Sentry vira no-op (não trava boot).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=

# ── Plausible (Analytics LGPD-friendly) — auditoria P1-2 ─────
# Sem domínio configurado, Plausible vira no-op.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io

# ── OpenTelemetry (Tracing + Metrics) ───────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=pedi-ai-api
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
# Modo: otlp (push, padrão 2025/2026) | prometheus (pull) | both.
# Default: otlp se OTEL_EXPORTER_OTLP_ENDPOINT setado, senão prometheus.
OTEL_METRICS_EXPORTER=
OTEL_METRIC_EXPORT_INTERVAL=30000
METRICS_PORT=9090
OTEL_DIAG_ENABLED=false

# ── Logging (pino) ─────────────────────────────────────────────
LOG_LEVEL=info

# ── Loki (logs centralizados) ───────────────────────────────────
LOKI_URL=
LOKI_USER=
LOKI_API_KEY=

# ── Feature Flags ────────────────────────────────────────────
# Fonte da verdade: `packages/shared/src/constants/feature-flags.ts`
# Toda flag DEVE estar aqui E em `apps/web/src/lib/feature-flags.ts`.
NEXT_PUBLIC_FEATURE_OFFLINE_ENABLED=true
NEXT_PUBLIC_FEATURE_PIX_ENABLED=true
NEXT_PUBLIC_FEATURE_QR_CODE_ENABLED=true
NEXT_PUBLIC_FEATURE_COMBOS_ENABLED=true
NEXT_PUBLIC_FEATURE_WAITER_MODE=true
NEXT_PUBLIC_FEATURE_ANALYTICS_ENABLED=true
NEXT_PUBLIC_FEATURE_CASHBACK_ENABLED=false
NEXT_PUBLIC_ENABLE_MULTI_RESTAURANT=false

# ============================================================
# ── Docker Compose (vars de bind/porta/profile) ────────────────
# ============================================================
# Por padrão o compose sobe só postgres + api + web.
# Para incluir profiles opcionais, use a flag --profile OU defina
# as variáveis ENABLE_* abaixo (Docker Compose lê ENV no `up`).

# Bind padrão 127.0.0.1 (acesso só via nginx/proxy). Trocar para
# 0.0.0.0 só em LAN dev (não recomendado em prod exposto à internet).
POSTGRES_BIND=127.0.0.1
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
API_PORT=3001
WEB_PORT=3000

# PROFILE: tools (pgAdmin + mailpit — dev/staging)
ENABLE_PGADMIN=false
ENABLE_MAILPIT=false
PGADMIN_BIND=127.0.0.1
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@pedi-ai.com
# [REQUIRED se ENABLE_PGADMIN=true] Senha do pgAdmin.
PGADMIN_PASSWORD=
MAILPIT_BIND=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# PROFILE: observability (OpenObserve + Prometheus — opt-in)
# Subir com: ENABLE_OBSERVABILITY=true docker compose --profile observability up -d
ENABLE_OBSERVABILITY=false
# OpenObserve (all-in-one: logs + metrics + traces + dashboards + alertas)
OO_BIND=127.0.0.1
OO_PORT=5080
# [REQUIRED se ENABLE_OBSERVABILITY=true] Senha inicial do admin OpenObserve.
# Após primeiro login, troque via UI.
OO_ADMIN_PASSWORD=
# Retention em horas. Default: 30d logs/traces, 90d métricas.
OO_LOGS_RETENTION=720
OO_METRICS_RETENTION=2160
OO_TRACES_RETENTION=720
# Compactação Parquet (10× redução de footprint no disco).
OO_COMPACT_RETENTION_DAYS=30
# Limites operacionais (VPS pequeno 2 CPU / 7.8 GB RAM).
OO_INGEST_LIMIT_MB=50
OO_MEM_BUFFER_MB=64
OO_MEMORY_LIMIT=800M
# Prometheus (opcional — para alertas Alertmanager)
PROM_BIND=127.0.0.1
PROM_PORT=9091
PROM_RETENTION=15d
PROM_MEMORY_LIMIT=400M

# OpenTelemetry endpoint (apontar para OpenObserve quando profile ativo).
# OpenObserve recebe OTLP em http://openobserve:5080/api/v1/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/v1/otlp
OTEL_SERVICE_NAME=pedi-ai-api
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_METRICS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=30000
METRICS_PORT=9090
LOG_LEVEL=info

# ============================================================
# ── Gerando secrets prod (executar 1x na VPS) ────────────────
# ============================================================
#
#   openssl rand -hex 32   # gera qualquer uma das chaves *_SECRET
#
# Gere pelo menos:
#   - JWT_SECRET
#   - JWT_REFRESH_SECRET
#   - PII_ENCRYPTION_KEY
#   - QR_SECRET_KEY
#   - SESSION_SECRET
#   - COOKIE_SECRET
#   - CSRF_SECRET
#   - MP_WEBHOOK_SECRET
#   - ASAAS_WEBHOOK_SECRET
#
# Trocar todos periodicamente invalida sessões — fazer com cuidado.